# Neon connection string (pooled). Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
# Required in production to open /admin/setup, so only the owner can create the first admin.
SETUP_TOKEN=change-me
# Public site address, used for canonical URLs, sitemap and WhatsApp links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
