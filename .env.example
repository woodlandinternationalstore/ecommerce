# Path of the SQLite database file (default: data/woodland.db). Back this file up.
DATABASE_FILE=data/woodland.db
# Required to open /admin/setup in production, so only the owner can create the first admin.
SETUP_TOKEN=change-me
# Public site address, used for canonical URLs, sitemap and WhatsApp links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
